# apps/api
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Neon Postgres
# DATABASE_URL usa el endpoint pooled (-pooler) para la API en ejecución.
# DIRECT_URL usa el endpoint directo para migraciones de Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Tests (PostgreSQL local)
DATABASE_URL_TEST="postgresql://postgres:test@localhost:5433/postgres"

# Better Auth
# Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-or-longer-secret
BETTER_AUTH_URL=http://localhost:3001

# Neon Object Storage (compatible con S3)
# Los valores se obtienen con `neon env pull` o desde la consola de Neon.
S3_ENDPOINT=https://br-xxxx.storage.eu-central-1.aws.neon.tech
S3_REGION=eu-central-1
S3_BUCKET=legaria-private
S3_ACCESS_KEY_ID=nak_live_xxxxxxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=nsk_live_xxxxxxxxxxxxxxxx

# apps/web
VITE_API_URL=http://localhost:3001/api/v1
VITE_AUTH_URL=http://localhost:3001/api/auth
