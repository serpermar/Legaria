{
    "name": "legaria",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "pnpm --parallel dev",
        "build": "pnpm -r build",
        "lint": "pnpm -r lint",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "db:generate": "pnpm --filter @legaria/api prisma:generate",
        "db:migrate": "pnpm --filter @legaria/api prisma:migrate",
        "db:seed": "pnpm --filter @legaria/api prisma:seed"
    },
    "devDependencies": {
        "typescript": "^5.6.3"
    },
    "packageManager": "pnpm@9.12.0"
}